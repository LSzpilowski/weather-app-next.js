# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and will never be committed.

# SheCodes Weather API key — get a free key at https://www.shecodes.io/weather
NEXT_PUBLIC_WEATHER_API_KEY=your_shecodes_api_key_here

# OpenWeatherMap Geocoding API key (used for "My location" reverse geocoding)
# Free tier is sufficient — sign up at https://openweathermap.org/api
NEXT_PUBLIC_GEOCODING_API_KEY=your_openweathermap_api_key_here

# Default city shown on first load
NEXT_PUBLIC_DEFAULT_CITY=Warsaw

# Your production URL (used for Open Graph metadata)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
